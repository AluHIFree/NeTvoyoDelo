SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=60

# Bind (локальный режим)
HOST=127.0.0.1
PORT=8000

# First admin (created on startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Не создавать стандартные отделы при старте (false = чистая установка)
SEED_DEFAULT_DEPARTMENTS=false

# CORS — comma-separated origins (no wildcard)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Public URL used in notification links
PUBLIC_BASE_URL=http://localhost:8000

# Email (SMTP) — Yandex: port 587 + TLS; port 465 + SSL
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NeTvoyoDelo
SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# Legacy aliases also supported: SMTP_USER, SMTP_FROM, SMTP_USE_SSL

# SMS provider
SMS_API_URL=https://sms.ru/send
SMS_API_KEY=

# Notifications scheduler
STALE_LETTER_DAYS=7
NOTIFICATION_SCHEDULE_HOURS=9,12,16

# Cloudflare Workers AI (отчёты о работе в профиле)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Обновления с GitHub (раздел «Обновления» для администратора)
GITHUB_REPO=AluHIFree/NeTvoyoDelo
GITHUB_UPDATE_BRANCH=main
# Опционально: токен при приватном репо или лимите API
# GITHUB_TOKEN=
